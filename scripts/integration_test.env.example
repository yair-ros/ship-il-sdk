# Copy this file to scripts/integration_test.env and fill real values locally.
# The real file is gitignored.

SHIP_CONFIRM_REAL_API_CALL=no

SHIP_API_USER=YOUR_USERNAME
SHIP_API_PASSWORD=YOUR_PASSWORD
SHIP_CUSTOMER_ID=YOUR_CUSTOMER_ID
SHIP_ENV=DEV

SHIP_CITY=Tel Aviv
SHIP_STREET=Herzl
SHIP_HOUSE_NUMBER=10
SHIP_POINT_TYPES=1
SHIP_POINTS_LIMIT=10

# Optional booking flows:
# SHIP_RUN_GET_PICKUP_DATES=no
# SHIP_RUN_GET_PICKUP_TIMES=no
# SHIP_RUN_INSERT_DOMESTIC_BOOKING=no
# SHIP_RUN_INSERT_EXPORT_BOOKING=no
# SHIP_RUN_CANCEL_BOOKING=no
# SHIP_BOOKING_CANCEL_REASON=SDK integration test cleanup

# Optional pickup shipment creation:
# SHIP_RUN_INSERT_PICKUP_SHIPMENT=no
# Backward-compatible alias for pickup shipment:
# SHIP_RUN_CREATE_SHIPMENT=no
# Shared consignee fields for pickup and standard shipment flows:
# SHIP_CONSIGNEE_CITY=Tel Aviv
# SHIP_CONSIGNEE_STREET=Herzl
# SHIP_CONSIGNEE_HOUSE_NUMBER=10
# SHIP_CONSIGNEE_CONTACT_PERSON=Test Customer
# SHIP_CONSIGNEE_CUSTOMER_NAME=Test Customer
# SHIP_CONSIGNEE_PHONE=0501234567
# Optional override. If omitted, the script resolves the nearest type-1 point.
# SHIP_PICKUP_POINT_TYPE=1
# SHIP_PICKUP_POINT_ID=PKPS734447
# SHIP_REFERENCE_1=ORDER-123
# SHIP_REFERENCE_2=CHANNEL-ABC
# SHIP_SHIPMENT_INSTRUCTIONS=SDK integration test
# SHIP_NUMBER_OF_PACKAGES=1

# Optional pickup-drop shipment creation:
# SHIP_RUN_INSERT_PICKUP_DROP_SHIPMENT=no
# Optional override. If omitted, the script resolves the nearest type-4 point.
# SHIP_PICKUP_DROP_POINT_TYPE=4
# SHIP_PICKUP_DROP_POINT_ID=PKP123456

# Optional standard shipment creation:
# SHIP_RUN_INSERT_STANDARD_SHIPMENT=no
# SHIP_STANDARD_WEIGHT=1.5
# SHIP_STANDARD_SHIPMENT_TYPE=0
# SHIP_STANDARD_NUMBER_OF_PACKAGES_TO_RETURN=0
# SHIP_STANDARD_DDO=no
# SHIP_STANDARD_IS_RETURN=no
# SHIP_STANDARD_UDR_VALUE=
# SHIP_STANDARD_COD_VALUE=
# SHIP_STANDARD_INSTRUCTION=Standard shipment integration test
# SHIP_STANDARD_PICKUP_POINT_ID=

# Optional picking-list call:
# SHIP_RUN_INSERT_PICKING_LIST=no
# If omitted, the script builds a minimal payload from the docs sample.
# SHIP_PICKING_LIST_PAYLOAD_JSON={"TrackNO":"TRACKING_NUMBER","Ref1":"ORDER-123","Items":[{"SKU1":"231111","Description":"Computer","Quantity":1}]}

# Optional PrintWBOrderDetails call:
# SHIP_RUN_PRINT_WB_ORDER_DETAILS=no
# If omitted, the script will use the tracking number returned by a shipment call.
# SHIP_PRINT_WB_ORDER_DETAILS_PARAMS_JSON={"trackingNumbers":"TRACKING_NUMBER","isA4Format":false}

# Optional wb-status call:
# SHIP_RUN_GET_WB_STATUS=no
# If omitted, the script will use the tracking number returned by a shipment call.
# SHIP_WB_STATUS_PARAMS_JSON={"trackingNumber":"TRACKING_NUMBER"}

# Optional pricing call:
# SHIP_RUN_GET_PRICING=no
# If omitted, the script uses the SHIP docs export example for US pricing.
# SHIP_PRICING_PAYLOAD_JSON={"PackageType":2,"IsExport":true,"ShipmentValue":10,"ToZipCode":"10015","ToCountryCode":"US","ToCity":"New york","Packages":[{"Length":0,"Width":0,"Height":0,"Weight":10}]}

# Optional label download:
# SHIP_RUN_DOWNLOAD_LABEL=no
# If omitted, the script will use the tracking number returned by a shipment call.
# SHIP_TRACKING_NUMBER=TRACKING_NUMBER
# SHIP_LABEL_FORMAT=thermal
# SHIP_LABEL_COPIES=1
# SHIP_LABEL_OUTPUT=ship-label.pdf
